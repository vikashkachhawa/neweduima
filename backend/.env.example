# Backend Environment Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eduima_db
JWT_SECRET=eduima_jwt_secret_key_change_this_in_production_2024
JWT_EXPIRE=24h
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://app.eduima.com
NODE_ENV=development

# EduMeet ICE (WebRTC) config
